*** Keywords ***

CLICK SIGNIN
    Click Link   //a[contains(text(),'Signup / Login')]

INPUT EMAIL
    [Arguments]    ${EMAIL}
    Input Text    //input[@name='email']    ${EMAIL}

INPUT PASSWORD
    [Arguments]    ${PASSWORD}
    Input Text    //input[@name='password']    ${PASSWORD}

CLICK BUTTON LOGIN
    Click Button    //button[contains(text(),'Login')]
    Wait Until Page Contains    Logged in as    timeout=10s

ADD PRODUCTS TO CART
    Click Element    //a[contains(text(),'Products')]
    Click Element    (//a[contains(text(),'Add to cart')])[1]
    Click Element    //a[contains(text(),'Cart')]
    Wait Until Page Contains    Shopping Cart    timeout=10s

OPEN CART
    Click Element    //a[contains(text(),'Cart')]
    Wait Until Page Contains    Shopping Cart    timeout=10s

VERIFY CART PAGE
    Wait Until Page Contains    Shopping Cart    timeout=10s

PROCEED TO CHECKOUT
    Click Link    //*[@id="do_action"]/div[1]/div/div/a

VERIFY ADDRESS AND ORDER DETAILS
    Wait Until Page Contains    Checkout    timeout=10s

ENTER ORDER DESCRIPTION
    Input Text    //textarea[@name='message']    Test order
    Click Link    //*[@id="cart_items"]/div/div[7]/a

ENTER PAYMENT DETAILS
    Input Text    //input[@name='name_on_card']    ${CARD_NAME}
    Input Text    //input[@name='card_number']    ${CARD_NUMBER}
    Input Text    //input[@name='cvc']    ${CARD_CVC}
    Input Text    //input[@name='expiry_month']    ${CARD_EXPIRY}
    Input Text    //input[@name='expiry_year']    ${YYYY}

CONFIRM ORDER
    Wait Until Page Contains    Your order has been placed successfully!    timeout=10s
    Click Button    //button[contains(text(),'Pay and Confirm Order')]

VERIFY ORDER SUCCESS
    Click Link    //*[@id="form"]/div/div/div/div/a

DELETE ACCOUNT
    Click Link    //*[@id="header"]/div/div/div/div[2]/div/ul/li[5]/a
    Wait Until Page Contains    Account Deleted!    timeout=10s
    Click Link    //*[@id="form"]/div/div/div/div/a

